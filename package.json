{
  "name": "octa-blaster",
  "description": "Extensão para envio de respostas rápidas em tickets de helpdesk",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "sign:firefox": "web-ext sign --source-dir .output/firefox-mv2 --artifacts-dir .output --channel unlisted",
    "compile": "vue-tsc --noEmit",
    "generate:icons": "node scripts/generate-icons.js",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.2.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
